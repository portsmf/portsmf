PROJECT_NAME           = @CMAKE_PROJECT_NAME@
PROJECT_NUMBER         = @CMAKE_PROJECT_VERSION@
PROJECT_BRIEF          = @CMAKE_PROJECT_DESCRIPTION@
OUTPUT_DIRECTORY       = @PROJECT_BINARY_DIR@/doc
TIMESTAMP              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
SORT_MEMBERS_CTORS_1ST = YES
QUIET                  = YES
INPUT                  = @PROJECT_SOURCE_DIR@/README.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/allegro.md \
                         @PROJECT_SOURCE_DIR@/include \
                         @PROJECT_SOURCE_DIR@/src
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cxxm \
                         *.cpp \
                         *.cppm \
                         *.ccm \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.hpp \
                         *.h++ \
                         *.dox
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/README.md
HTML_EXTRA_STYLESHEET  = @CMAKE_CURRENT_SOURCE_DIR@/extra.css
GENERATE_LATEX         = NO
