PROJECT_NAME           = portsmf
PROJECT_NUMBER         = @CMAKE_PROJECT_VERSION@
PROJECT_BRIEF          = "C++ library for reading and writing Standard MIDI files"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@
TIMESTAMP              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
SORT_MEMBERS_CTORS_1ST = YES
QUIET                  = YES
INPUT                  = @DOXYGEN_INPUT_DIR@/README.md \
                         @DOXYGEN_INPUT_DIR@/include \
                         @DOXYGEN_INPUT_DIR@/src
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cxxm \
                         *.cpp \
                         *.cppm \
                         *.ccm \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.hpp \
                         *.h++ \
                         *.dox
USE_MDFILE_AS_MAINPAGE = @DOXYGEN_INPUT_DIR@/README.md
GENERATE_LATEX         = NO
